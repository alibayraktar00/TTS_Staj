DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tts_db
DB_PORT=3306

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=24h

PORT=5000
NODE_ENV=development

# Frontend'in çalıştığı origin (prod'da gerçek domain ile değiştirin)
CORS_ORIGIN=http://localhost:3000

# Nginx/Apache gibi bir reverse proxy arkasındaysa true yapın
TRUST_PROXY=false

# Talep bildirim mailleri için Gmail SMTP (Uygulama Şifresi gerekir, normal hesap şifresi değil)
GMAIL_USER=ornek@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
